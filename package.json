{"dependencies":{"@cosmjs/stargate":"^0.39.0","@noble/ciphers":"^1.3.0","@noble/post-quantum":"^0.7.1","@qorechain/evm":"^0.14.0","@qorechain/qorex-rainbowkit":"^0.1.0","@qorechain/sdk":"^0.14.0","@rainbow-me/rainbowkit":"^2.2.11","@scure/bip39":"^2.4.0","@tanstack/react-query":"^5.59.0","react":"^18.3.1","react-dom":"^18.3.1","viem":"^2.0.0","wagmi":"^2.19.5"},"description":"SealedBid: sealed-bid auctions on the QoreChain testnet (qorechain-diana). Bids are encrypted client-side with ML-KEM-1024 to the auctioneer's chain-registered public key, so bids stay sealed on-chain until the reveal phase.","devDependencies":{"@types/node":"^22.7.5","@types/react":"^18.3.0","@types/react-dom":"^18.3.0","@vitejs/plugin-react":"^4.3.0","ganache":"^7.9.2","tsx":"^4.19.0","typescript":"^5.6.3","vite":"^5.4.0"},"name":"sealedbid","private":true,"scripts":{"build":"tsc --noEmit && vite build","compile":"npx solc@0.8.24 --optimize --abi --bin -o out contracts/SealedBid.sol && node scripts/build-artifact.mjs","deploy":"tsx --env-file=.env scripts/deploy.ts","dev":"vite","e2e":"tsx --env-file=.env scripts/e2e.ts","preview":"vite preview","register-kem":"tsx --env-file=.env scripts/register-kem.ts","test":"tsx --test test/*.test.ts","typecheck":"tsc --noEmit","window":"tsx --env-file=.env scripts/window.ts"},"type":"module","version":"0.0.0"}